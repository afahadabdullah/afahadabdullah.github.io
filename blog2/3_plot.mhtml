    <div class=3D"input_area">
<div class=3D" highlight hl-python"><pre><span></span><span class=3D"nb">ma=
p</span> <span class=3D"o">=3D</span> <span class=3D"n">plt</span><span cla=
ss=3D"o">.</span><span class=3D"n">axes</span><span class=3D"p">(</span><sp=
an class=3D"n">projection</span><span class=3D"o">=3D</span><span class=3D"=
n">ccrs</span><span class=3D"o">.</span><span class=3D"n">PlateCarree</span=
><span class=3D"p">())</span> <span class=3D"c1"># defining axes and projec=
tion* and assigned it to `map`</span>
<span class=3D"nb">map</span><span class=3D"o">.</span><span class=3D"n">co=
astlines</span><span class=3D"p">()</span> <span class=3D"c1"># add coastli=
nes</span>
</pre></div>

