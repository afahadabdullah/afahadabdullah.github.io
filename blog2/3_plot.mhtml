<div class=3D" highlight hl-python"><pre><span></span><span class=3D"c1">#I=
mporting packages</span>
<span class=3D"kn">import</span> <span class=3D"nn">matplotlib.pyplot</span=
> <span class=3D"kn">as</span> <span class=3D"nn">plt</span>
<span class=3D"kn">import</span> <span class=3D"nn">numpy</span> <span clas=
s=3D"kn">as</span> <span class=3D"nn">np</span>
<span class=3D"c1">#Creating random list of 8 numbers.</span>
<span class=3D"n">data</span> <span class=3D"o">=3D</span> <span class=3D"n=
b">list</span><span class=3D"p">(</span><span class=3D"n">np</span><span cl=
ass=3D"o">.</span><span class=3D"n">random</span><span class=3D"o">.</span>=
<span class=3D"n">randint</span><span class=3D"p">(</span><span class=3D"mi=
">1</span><span class=3D"p">,</span> <span class=3D"mi">150</span><span cla=
ss=3D"p">,</span> <span class=3D"mi">8</span><span class=3D"p">))</span>
<span class=3D"c1">#Plotting the horizontal bar.</span>
<span class=3D"n">plt</span><span class=3D"o">.</span><span class=3D"n">bar=
</span><span class=3D"p">(</span><span class=3D"nb">range</span><span class=
=3D"p">(</span><span class=3D"nb">len</span><span class=3D"p">(</span><span=
 class=3D"n">data</span><span class=3D"p">)),</span> <span class=3D"n">data=
</span><span class=3D"p">,</span> <span class=3D"n">color</span><span class=
=3D"o">=3D</span><span class=3D"s1">'#900C3F'</span><span class=3D"p">)</sp=
an>
<span class=3D"c1">#showing the plot</span>
<span class=3D"n">plt</span><span class=3D"o">.</span><span class=3D"n">sho=
w</span><span class=3D"p">()</span>
</pre></div>

