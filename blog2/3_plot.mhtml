<div class=3D"inner_cell">
    <div class=3D"input_area">
<div class=3D" highlight hl-python"><pre><span></span><span class=3D"kn">im=
port</span> <span class=3D"nn">matplotlib.pyplot</span> <span class=3D"kn">=
as</span> <span class=3D"nn">plt</span>
<span class=3D"kn">import</span> <span class=3D"nn">numpy</span> <span clas=
s=3D"kn">as</span> <span class=3D"nn">np</span>

<span class=3D"c1"># Generate random data</span>
<span class=3D"n">x</span> <span class=3D"o">=3D</span> <span class=3D"n">n=
p</span><span class=3D"o">.</span><span class=3D"n">linspace</span><span cl=
ass=3D"p">(</span><span class=3D"o">-</span><span class=3D"mi">5</span><spa=
n class=3D"p">,</span> <span class=3D"mi">5</span><span class=3D"p">,</span=
> <span class=3D"mi">100</span><span class=3D"p">)</span>
<span class=3D"n">y</span> <span class=3D"o">=3D</span> <span class=3D"n">n=
